# External origin (scheme + host + port). Must match what browsers use.
DSH_SERVER_PUBLIC_URL=https://remote.example.com

# PostgreSQL
DATABASE_URL=postgres://dsh:change-me@postgres:5432/dsh
POSTGRES_PASSWORD=change-me

# Listen address
DSH_SERVER_PORT=8080
DSH_SERVER_HOST=0.0.0.0

# One-time bootstrap key (generated when empty; printed at boot)
DSH_SETUP_KEY=

# Reverse proxy peers allowed to supply X-Forwarded-For
DSH_SERVER_TRUSTED_PROXY_IPS=

# Sessions and limits
DSH_SESSION_TTL_MS=28800000
DSH_USER_RATE_PER_MINUTE=600
DSH_ANON_RATE_PER_MINUTE=30
DSH_USER_CONNECTION_LIMIT=16

# Emergency: keep password login available in SSO-only mode
DSH_BREAK_GLASS_PASSWORD=

# SMTP (self-registration, password reset, email change)
DSH_SMTP_HOST=
DSH_SMTP_PORT=587
DSH_SMTP_SECURE=0
DSH_SMTP_USER=
DSH_SMTP_PASS=
DSH_SMTP_FROM=

# OIDC bootstrap (also editable in the admin console)
DSH_OIDC_ISSUER=
DSH_OIDC_CLIENT_ID=
DSH_OIDC_CLIENT_SECRET=
DSH_OIDC_ALLOWED_DOMAINS=

# ICE handed to clients
DSH_SERVER_STUN_URLS=
DSH_SERVER_TURN_URLS=
DSH_SERVER_TURN_USERNAME=
DSH_SERVER_TURN_PASSWORD=

DSH_SERVER_LOG_LEVEL=info
