# ── 基础 ────────────────────────────────────────────────────────────────────
DSH_SERVER_PUBLIC_URL=https://app.example.com
DSH_SERVER_PORT=8080
DSH_SERVER_HOST=0.0.0.0
# 反向代理后的真实客户端 IP 解析；不填则所有请求共用一个限流桶
DSH_SERVER_TRUSTED_PROXY_IPS=

# ── 数据库 ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://dsh:change-me@postgres:5432/dsh

# ── 会话与限速 ──────────────────────────────────────────────────────────────
DSH_SESSION_TTL_MS=28800000
DSH_USER_RATE_PER_MINUTE=600
DSH_ANON_RATE_PER_MINUTE=30
DSH_USER_CONNECTION_LIMIT=16

# ── OIDC（可选；留空则只用密码 + 设备密钥）─────────────────────────────────
DSH_OIDC_ISSUER=
DSH_OIDC_CLIENT_ID=
DSH_OIDC_CLIENT_SECRET=
DSH_OIDC_SCOPES=openid email profile
DSH_OIDC_ALLOWED_DOMAINS=
DSH_OIDC_AUTO_PROVISION=true

# ── ICE（可选，第三方 TURN 用静态凭据）────────────────────────────────────
DSH_SERVER_STUN_URLS=stun:stun.cloudflare.com:3478
DSH_SERVER_TURN_URLS=
DSH_SERVER_TURN_USERNAME=
DSH_SERVER_TURN_PASSWORD=
DSH_SERVER_TURN_SECRET=

# ── SMTP（留空则关闭自助注册与找回密码）──────────────────────────────
DSH_SMTP_HOST=
DSH_SMTP_PORT=587
DSH_SMTP_SECURE=0
DSH_SMTP_USER=
DSH_SMTP_PASS=
DSH_SMTP_FROM=DSH Remote <no-reply@example.com>
