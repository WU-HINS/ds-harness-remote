{
  "name": "ds-harness-remote-server",
  "private": true,
  "version": "1.6.0",
  "description": "Self-hosted multi-user server for DeepSeek Harness remote access",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @dsh-remote/server dev",
    "build": "pnpm --filter @dsh-remote/protocol build && pnpm --filter @dsh-remote/server build",
    "check": "pnpm -r check",
    "test": "pnpm --filter @dsh-remote/server test",
    "test:pg": "pnpm --filter @dsh-remote/server test:pg",
    "start": "pnpm --filter @dsh-remote/server start"
  }
}
